# ============================================================
# Environment Variables - Copy this to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# --- GCP Configuration ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BUCKET_NAME=your-rag-documents-bucket
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# --- Network policy ---
# true  = the app may call services outside the company network
#         (cloud LLMs, Hugging Face downloads, bitbucket.org, Jira Cloud, telemetry).
# false = only hosts under INTERNAL_DOMAINS, localhost (Ollama) and private IPs;
#         everything else is blocked with a clear error. Download models first
#         (download_model.py) while this is true, then switch it to false.
ALLOW_EXTERNAL_NETWORK=true
INTERNAL_DOMAINS=nxp.com

# --- Indexing speed ---
# CPU threads for embedding / re-ranking (0 = half the cores, leaving the rest to Ollama)
EMBEDDING_THREADS=0
# How many sources index at the same time; the rest wait in a queue
INDEX_PARALLEL_JOBS=2

# --- LLM Configuration ---
# Provider priority: GEMINI_API_KEY -> OPENAI_API_KEY -> OLLAMA_MODEL.
# Leave both keys EMPTY to use the free local Ollama model (install Ollama,
# then run: ollama pull llama3.2). Any non-empty key value counts as "set".
OLLAMA_MODEL=llama3.2
# Context window requested from Ollama (its default 4096 is too small for RAG prompts;
# larger values cost memory and CPU time)
OLLAMA_NUM_CTX=8192
# Local vision model for questions with attached images (install: ollama pull gemma3:4b)
OLLAMA_VISION_MODEL=gemma3:4b
# Local code model for "write / fix / add tests" requests (install: ollama pull qwen2.5-coder:7b)
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
# Seconds before a model call is abandoned (CPU-only PCs need minutes for images and code)
LLM_TIMEOUT=600
GEMINI_API_KEY=
VERTEX_AI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- LiteLLM Gateway ---
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_BUDGET_LIMIT=10.0

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For production use Vertex AI embeddings:
# EMBEDDING_MODEL=textembedding-gecko@003

# --- Vector Store ---
# Options: chroma (local dev), vertexai (production)
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
# Vertex AI Vector Search (production)
VERTEX_AI_INDEX_ID=your-index-id
VERTEX_AI_INDEX_ENDPOINT_ID=your-endpoint-id

# --- Re-Ranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_THRESHOLD=0.3

# --- Guardrails ---
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
ENABLE_PII_DETECTION=true

# --- Evaluations ---
ENABLE_INLINE_EVALS=true
EVAL_SAMPLE_RATE=1.0

# --- Observability ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
BIGQUERY_DATASET=rag_metrics

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
