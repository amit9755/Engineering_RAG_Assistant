# ============================================================
# Environment Variables - Copy this to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# --- GCP Configuration ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BUCKET_NAME=your-rag-documents-bucket
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# --- LLM Configuration ---
# Primary LLM via Vertex AI (Gemini)
VERTEX_AI_MODEL=gemini-1.5-pro
# Fallback LLM (OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- LiteLLM Gateway ---
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_BUDGET_LIMIT=10.0

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For production use Vertex AI embeddings:
# EMBEDDING_MODEL=textembedding-gecko@003

# --- Vector Store ---
# Options: chroma (local dev), vertexai (production)
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
# Vertex AI Vector Search (production)
VERTEX_AI_INDEX_ID=your-index-id
VERTEX_AI_INDEX_ENDPOINT_ID=your-endpoint-id

# --- Re-Ranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_THRESHOLD=0.3

# --- Guardrails ---
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
ENABLE_PII_DETECTION=true

# --- Evaluations ---
ENABLE_INLINE_EVALS=true
EVAL_SAMPLE_RATE=1.0

# --- Observability ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
BIGQUERY_DATASET=rag_metrics

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
